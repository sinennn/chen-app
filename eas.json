{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "production": {
      "distribution": "store",
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_WITH_ASC_APP_ID",
        "appleTeamId": "ZCVDURU2BZ",
        "ascApiKeyPath": "./secrets/asc-api-key.json"
      },
      "android": {
        "track": "production",
        "serviceAccountKeyPath": "./secrets/google-service-account.json"
      }
    }
  }
}
